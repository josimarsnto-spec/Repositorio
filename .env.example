NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://condosphere:condosphere@postgres:5432/condosphere
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

